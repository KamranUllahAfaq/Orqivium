show pdbs;
ALTER SYSTEM SET PROCESSES=500 SCOPE=SPFILE;
alter session set container= freepdb1;
create user orqivium identified by orqivium DEFAULT TABLESPACE users quota unlimited on users;
grant DB_DEVELOPER_ROLE to orqivium;

BEGIN
CTX_DDL.CREATE_PREFERENCE('orqivium.world_lexer','WORLD_LEXER');
END;
/
